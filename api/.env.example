# Copy to .env locally; replace placeholders. Never commit .env.
DATABASE_URL=postgresql+psycopg://crosslearn:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/crosslearn
APP_ENV=development
SYNTHETIC_DATA_ONLY=true
# Backend-only provider; rules work without a model or key.
MODEL_PROVIDER=none
MODEL_ENDPOINT=http://127.0.0.1:11434/api/chat
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=15
COOKIE_SECURE=false
